# ──────────────────────────────────────────────────────────────
# Sai Enterprises — Apache config for shared hosting (GoDaddy cPanel,
# Turbify, or any Apache host). Identical requirements on all of them.
# Lives in public/ so every `npm run build` copies it into dist/.
# ──────────────────────────────────────────────────────────────

# 1. SPA routing. React Router owns the URLs, so any request that is not a
#    real file or directory must be served index.html; otherwise deep links
#    such as /machinery or /contact return a 404 straight from Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # GoDaddy shared hosting enables MultiViews, which makes Apache guess at
  # extensionless URLs before the rewrite rules run and can swallow app
  # routes. Turning it off here keeps routing predictable.
  <IfModule mod_negotiation.c>
    Options -MultiViews
  </IfModule>

  RewriteRule ^index\.html$ - [L]

  # Real files and directories are served as-is (assets, PDFs, images).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is an application route.
  RewriteRule . /index.html [L]
</IfModule>

# 2. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# 3. Caching. Asset filenames carry a content hash so they can be cached hard.
#    index.html must not be, or visitors keep getting the previous deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType application/pdf        "access plus 1 month"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Correct types for fonts and modern image formats
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/pdf .pdf
</IfModule>

ErrorDocument 404 /index.html
